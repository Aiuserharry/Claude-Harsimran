# Path to the Firebase service account JSON (Firebase console > Project settings > Service accounts)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Port the backend HTTP server listens on
PORT=4000

# How often (in milliseconds) to check prices against your limits.
# Free Yahoo Finance quotes are already delayed ~15 min, so there's
# little benefit to polling faster than this.
POLL_INTERVAL_MS=30000
